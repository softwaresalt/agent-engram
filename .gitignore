# Generated by Cargo
# will have compiled files and executables
debug
target
target-*/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# OS-generated files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.github/copilot/
.idea/
*.prj
*.pui
*.sublime-workspace
*.sublime-project
.github/copilot/

# Dev data directories for engram daemon debugging
.engram-dev-data/
.engram-dev-data-alt/


# Local environment files (secrets) — never commit. Only .env.example may be tracked.
.env
.env.local
.env.*.local
.env.*
*.env
.copilot/
tools/
.bin/
.mcp.json

# Logs and temp files
*.log
*.tmp
*.swp
*.txt
logs/
temp/
tmp/
*.txt

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Engram runtime data (keep templates/, registry.yaml, .version)
.engram/
!.engram/.version
!.engram/.workspace-id
!.engram/config.toml
!.engram/registry.yaml

# Agent file locks (gsd file-lock skill)
.*.lock
**/.*.lock

# fd-lock advisory lock sidecar for CozoDB SQLite (transient, OS-managed)
**/*.db.lock

# gsd staging verification reports (machine-specific paths, not portable)
.gsd/backups/
.gsd/staging/

# gsd tuning reports (machine-specific paths, not portable across environments)
.gsd/tuning-reports/*.json

# Backlogit tool-managed database (regenerated by backlogit sync)
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal
.backlogit/*.db-journal
.backlogit/telemetry/
.backlogit/runtime/
.backlogit/telemetry.jsonl
.backlogit/telemetry-sessions.jsonl
.backlogit/.telemetry-checkpoint.json
.backlogit/.locks/
.backlogit/.stash.md

# kbdb — managed by kbdb install
.kbdb/

# gsd-runtime-ignore
.gsd/gsd
.gsd/gsd.exe
.gsd/*.exe
.gsd/*.old
.gsd/*.bak
.gsd/*.zip
.gsd/SHA256SUMS
.gsd/runtime-manifest.json
.gsd/activation-intent.json
.gsd/runtime/
.gsd/worktree-baseline.json
