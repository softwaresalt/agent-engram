# Generated by Cargo
# will have compiled files and executables
debug
target
target-*/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# OS-generated files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/
*.prj
*.pui
*.sublime-workspace
*.sublime-project

# Dev data directories for engram daemon debugging
.engram-dev-data/
.engram-dev-data-alt/

# Environment and secrets
.env
.env.*
*.env
.copilot/
.mcp.json

# Logs and temp files
*.log
*.tmp
*.swp
*.txt
logs/
temp/
*.txt

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# engram plugin (workspace-local state)
.engram/

# Agent file locks (autoharness file-lock skill)
.*.lock
**/.*.lock

# Global harness management agents injected by start.ps1 at CLI launch
# These are copies from the autoharness global install — not workspace-owned.
.github/local-agents/

# Autoharness staging verification reports (machine-specific paths, not portable)
.autoharness/staging/verify-workspace-report.md
.autoharness/staging/verify-workspace-report.json

# Autoharness tuning reports (machine-specific paths, not portable across environments)
.autoharness/tuning-reports/*.json

# Backlogit tool-managed database (regenerated by backlogit sync)
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal